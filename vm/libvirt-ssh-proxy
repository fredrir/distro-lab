#!/usr/bin/env bash
set -euo pipefail

vm="${1:?usage: libvirt-ssh-proxy <vm-name> <port>}"
port="${2:-22}"

if ! virsh -c qemu:///system domstate "$vm" >/dev/null 2>&1; then
    echo "Unknown libvirt VM: $vm" >&2
    exit 1
fi

state="$(virsh -c qemu:///system domstate "$vm" 2>/dev/null)"

if [[ "$state" != "running" ]]; then
    echo "VM '$vm' is not running (state: $state)" >&2
    exit 1
fi

ip=""

# Give DHCP a few seconds after VM startup.
for _ in {1..20}; do
    ip="$(
        virsh -c qemu:///system domifaddr "$vm" --source lease 2>/dev/null |
        awk '$3 == "ipv4" {
            split($4, addr, "/");
            print addr[1];
            exit
        }'
    )"

    [[ -n "$ip" ]] && break
    sleep 0.5
done

if [[ -z "$ip" ]]; then
    echo "No IPv4 DHCP lease found for '$vm'" >&2
    exit 1
fi

exec nc "$ip" "$port"
