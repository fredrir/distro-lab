Host dlab-*
    User fredrir
    ProxyCommand ssh -T -o LogLevel=ERROR archie /storage/distro-lab/src/vm/libvirt-ssh-proxy %h %p
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
    LogLevel ERROR
    ConnectTimeout 300
    ServerAliveInterval 30
    ServerAliveCountMax 6
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
